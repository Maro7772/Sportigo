{
  "name": "scouting-super-admin",
  "version": "1.0.0",
  "private": true,
  "description": "Scouting platform super admin API - multi-tenant clubs (Node.js, Express, MongoDB, TypeScript)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/scripts/seed.ts",
    "seed:demo": "tsx src/scripts/seed.ts --demo",
    "seed:real": "tsx src/scripts/seed-real.ts",
    "seed:tenant": "tsx src/scripts/seed-tenant.ts",
    "db:check": "tsx src/scripts/check-db.ts",
    "test:smoke": "tsx test/smoke.ts",
    "test:live": "tsx test/live-check.ts",
    "test:reset-live": "node test/reset-live.mjs",
    "test:host": "tsx test/host-resolution.ts",
    "test:openapi": "tsx test/openapi-check.ts",
    "openapi": "tsx src/scripts/generate-openapi.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.1",
    "morgan": "^1.10.1",
    "multer": "^2.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.10.1",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
