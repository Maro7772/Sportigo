# ------------------------------------------------------------------
# Server
# ------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/scouting_super_admin
# Used only if MONGODB_URI has no database name (e.g. Atlas URI ending with "/?ssl=true")
MONGODB_DB_NAME=scouting_super_admin

# ------------------------------------------------------------------
# Auth
# ------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
# Lifetime of a club (tenant) admin token
TENANT_JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------
# Initial super admin (created on first boot if it does not exist)
# Leave empty to skip automatic creation and use `npm run seed`
# ------------------------------------------------------------------
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@scouting.local
SUPER_ADMIN_PASSWORD=Admin@123456

# ------------------------------------------------------------------
# CORS (comma separated, use * to allow all)
# ------------------------------------------------------------------
CORS_ORIGINS=*

# ------------------------------------------------------------------
# Uploads (local disk)
# ------------------------------------------------------------------
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=5
# Public origin for absolute file URLs (payment method icons, proofs...)
# Example: https://sportego.org
PUBLIC_BASE_URL=

# ------------------------------------------------------------------
# Tenants (wildcard subdomains)
# Each club gets its own database. The database name is the subdomain
# (ahly.example.com -> database "ahly"). Set a prefix only if you want
# names like "tenant_ahly".
# ------------------------------------------------------------------
TENANT_DB_PREFIX=

# First admin created inside every new club database.
# Email is always admin@<subdomain>.com; change the password after first login.
TENANT_DEFAULT_PASSWORD=123456
